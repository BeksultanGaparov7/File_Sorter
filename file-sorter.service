[Unit]
Description=File Sorter - sort new downloads into folders
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/file-sorter --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
